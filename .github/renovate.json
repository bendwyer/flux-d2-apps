{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "separateMinorPatch": true,
  "flux": { "managerFilePatterns": ["/components/.+\\.yaml$/"] },
  "kubernetes": { "managerFilePatterns": ["/components/.+\\.yaml$/"] },
  "github-actions": { "enabled": false },
  "customManagers": [
    {
      "description": "Track kcc by GitHub release: the registry has orphan tags (v11.0.0) and no prerelease flag. Bare tag, no digest available.",
      "customType": "regex",
      "managerFilePatterns": ["/components/books/base/workflows/.+\\.yaml$/"],
      "matchStrings": ["image:\\s+ghcr\\.io/ciromattia/kcc:(?<currentValue>[^@\\s]+)"],
      "depNameTemplate": "ciromattia/kcc",
      "versioningTemplate": "semver-coerced",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Use semver-coerced versioning for docker images",
      "matchDatasources": ["docker"],
      "versioning": "semver-coerced",
      "pinDigests": true
    },
    {
      "description": "Automerge patch+minor for >=1.x images",
      "matchDatasources": ["docker"],
      "matchCurrentVersion": "/^v?[1-9]/",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge patch only for 0.x images",
      "matchDatasources": ["docker"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Group comictagger across all manifests",
      "matchPackageNames": ["ghcr.io/bendwyer/containers/comictagger"],
      "groupName": "comictagger"
    },
    {
      "description": "Group ebook-metadata across all manifests",
      "matchPackageNames": ["ghcr.io/bendwyer/containers/ebook-metadata"],
      "groupName": "ebook-metadata"
    },
    {
      "description": "kcc: skip GitHub prereleases (kcc tags X.Y.0/X.Y.1 as prerelease before promoting). Never automerge.",
      "matchPackageNames": ["ciromattia/kcc"],
      "groupName": "kcc",
      "ignoreUnstable": true,
      "automerge": false
    },
    {
      "description": "kcc: docker view lists orphan tags with no release behind them, superseded by the github-releases manager.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ciromattia/kcc"],
      "enabled": false
    },
    {
      "description": "Kavita: filter out nightly/canary tags; stable releases are bare X.Y.Z[.W]. Use loose versioning to compare 4-segment hotfixes like 0.8.9.1 correctly.",
      "matchPackageNames": ["ghcr.io/kareadita/kavita"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(\\.\\d+)?$/",
      "versioning": "loose"
    },
    {
      "description": "Tika: hold at 3.x until tika-client speaks Tika 4 (stumpylog/tika-client#87); Tika 4 dropped /tika/form/* so paperless-ngx fails every Office parse with a 404. Docker versioning keeps the -full variant, which semver-coerced drops by coercing 3.3.1.0-full to 3.3.1.",
      "matchPackageNames": ["docker.io/apache/tika"],
      "allowedVersions": "/^3\\./",
      "versioning": "docker"
    }
  ]
}
